 "1": {
  "actors": {
   "A": {
    "type": "new_user"
   }
  },
  "steps": [
   {
    "id": "s1",
    "actor": "A",
    "call": "POST /api/v1/items/",
    "role": "action",
    "body": {
     "title": "ref item {{rand.str}}",
     "description": "ref desc"
    }
   }
  ],
  "checks": [
   {
    "id": "C1",
    "step": "s1",
    "expect": "status",
    "value": 200,
    "kind": "format",
    "description": "create returns 200"
   },
   {
    "id": "C2",
    "step": "s1",
    "expect": "field_equals",
    "field": "title",
    "value": "{{s1.req.title}}",
    "kind": "meaning",
    "description": "title echoed"
   },
   {
    "id": "C3",
    "step": "s1",
    "expect": "field_equals",
    "field": "description",
    "value": "{{s1.req.description}}",
    "kind": "meaning",
    "description": "description echoed"
   },
   {
    "id": "C4",
    "step": "s1",
    "expect": "field_exists",
    "field": "id",
    "kind": "meaning",
    "description": "id present"
   },
   {
    "id": "C5",
    "step": "s1",
    "expect": "field_equals",
    "field": "owner_id",
    "value": "{{A.id}}",
    "kind": "meaning",
    "description": "owner is creator"
   }
  ]
 },
